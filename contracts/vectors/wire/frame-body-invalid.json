{
  "name": "frame-body-invalid",
  "description": "Frame bodies every implementation MUST reject. The size and hash cases are the security surface: both are well-formed JSON and are accepted by schema validation alone.",
  "cases": [
    {
      "name": "unknown-frame-type",
      "reason": "type byte is not 0x01 and MUST be rejected",
      "bodyHex": ""
    },
    {
      "name": "meta-length-overruns-body",
      "reason": "metaLen is within the 65535 cap but points past the end of the frame body",
      "bodyHex": ""
    },
    {
      "name": "meta-length-over-cap",
      "reason": "metaLen exceeds the 65535 cap",
      "bodyHex": ""
    },
    {
      "name": "size-disagrees-with-payload",
      "reason": "declared size does not equal payloadBytes.length; invisible to JSON Schema",
      "bodyHex": ""
    },
    {
      "name": "hash-disagrees-with-payload",
      "reason": "hash does not equal sha256(payloadBytes); invisible to JSON Schema",
      "bodyHex": ""
    },
    {
      "name": "payload-present-in-metadata",
      "reason": "metaJSON MUST NOT carry a payload field; the bytes travel outside it",
      "bodyHex": ""
    },
    {
      "name": "truncated-header",
      "reason": "fewer than 5 bytes, so type and metaLen cannot be read",
      "bodyHex": "010000"
    }
  ]

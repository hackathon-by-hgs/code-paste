# Desktop Agent Environment Variables
# These are required variables, no real values.

# Control-plane ORIGIN ONLY. The API version (/v1) is appended by internal/config
# per ADR-008, so do not include it here.
CODEPASTE_API_URL=https://api.example.local

# Fallback state directory, used only when the machine has no OS credential
# store. Defaults to the OS user config dir when unset.
CODEPASTE_STATE_DIR=

# TCP port this agent accepts peer connections on.
CODEPASTE_LISTEN_PORT=47800

# Comma-separated host:port peers, for networks that filter multicast or peers
# on another subnet. Usually unnecessary: mDNS finds peers on the local link.
CODEPASTE_PEERS=

# Set to "off" to disable mDNS. Needed to run two agents on one host, since they
# cannot both receive on UDP 5353.
CODEPASTE_MDNS=

# Credential-store account name. Change it to run a second agent on one machine.
CODEPASTE_KEY_ACCOUNT=

# Clipboard backend: "os" (default) or "file:<path>".
# The file backend exists so two agents can be demonstrated on ONE machine,
# where they would otherwise share a single real clipboard and prove nothing.
CODEPASTE_CLIPBOARD=os

# Log verbosity: error | info | debug.
# NOTE: no level ever logs clipboard content, keys, tokens or pairing codes.
CODEPASTE_LOG_LEVEL=info

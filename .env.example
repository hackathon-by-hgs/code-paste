# Frontend Environment Variables
# These are required variables, no real values.
# Copy to frontend/.env.local — Next.js reads env from the app root, not the branch root.

# Control-plane ORIGIN ONLY. The API version (/v1) is appended by src/lib/config.ts
# per ADR-008, so do not include it here.
NEXT_PUBLIC_API_URL=https://api.example.local

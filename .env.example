# Copy to .env at THIS directory (the branch root), next to this file:
#
#   cp .env.example .env
#
# `npm start` and `npm run start:dev` load it with Node's built-in --env-file-if-exists, so no
# dotenv dependency is involved. Every value below is a safe local-development default and the
# app starts with them unchanged.
#
# A real environment variable always wins over this file. That is deliberate: a container or a
# platform's secret store must never be overridden by a file that happened to be present.
# Containers therefore ignore .env entirely -- see backend/DEPLOYMENT.md.
#
# Never commit .env (DEV_GUIDE.md §9). It is gitignored; only this example is tracked.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL unset to run against in-process PGlite (real PostgreSQL,
# no Docker required). Set it to use a real server. See ADR-007.
# DATABASE_URL=postgres://postgres:dev@localhost:5432/code_paste
DATABASE_POOL_MAX=10

# --- Authentication (ADR-004) -----------------------------------------------
# Minimum 32 bytes. The app refuses to start if this is missing or too short.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_JWT_SECRET=dev-only-insecure-secret-change-me-at-least-32-bytes-long
AUTH_JWT_ISSUER=code-paste-control-plane
AUTH_JWT_AUDIENCE=code-paste-clients
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_CLOCK_TOLERANCE_SECONDS=30

# --- Roster signing (ADR-003) -----------------------------------------------
# Ed25519 private key, 32 raw bytes, base64. Generated at boot in development
# if unset; REQUIRED in production, where a missing value is a startup failure.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ROSTER_SIGNING_SECRET_KEY=
ROSTER_TTL_SECONDS=300

# --- Device pairing (ADR-005) -----------------------------------------------
PAIRING_CODE_TTL_SECONDS=300
DEVICE_HEARTBEAT_COALESCE_SECONDS=300

# --- Share sessions ---------------------------------------------------------
SHARE_SESSION_DEFAULT_TTL_SECONDS=3600
SHARE_SESSION_MAX_TTL_SECONDS=86400

# --- Realtime (ADR-006) -----------------------------------------------------
REALTIME_HEARTBEAT_INTERVAL_SECONDS=30
REALTIME_MAX_CONNECTIONS_PER_DEVICE=2
REALTIME_MAX_CONNECTIONS_PER_USER=20
REALTIME_MAX_MESSAGE_BYTES=8192
REALTIME_MESSAGES_PER_MINUTE=60
REALTIME_MAX_MALFORMED_MESSAGES=5

# --- Abuse controls ---------------------------------------------------------
HTTP_MAX_BODY_BYTES=65536
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_SIGNUP_PER_HOUR=10
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_PAIRING_PER_HOUR=20
RATE_LIMIT_REGISTER_DEVICE_PER_HOUR=20
RATE_LIMIT_SESSION_JOIN_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120
